# DeepSeek Anthropic 兼容 API
# DeepSeek Anthropic-compatible API
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=10000

# 普通对话思考设置
# Conversation thinking settings
AGENT_CONVERSATION_THINKING_ENABLED=1
AGENT_CONVERSATION_THINKING_EFFORT=high
AGENT_CONVERSATION_SHOW_THINKING=0

# 记忆系统与记忆整理思考设置
# Memory system and compaction thinking settings
AGENT_MEMORY_SHOW_THINKING=0
AGENT_MEMORY_COMPACT_AFTER=18
AGENT_MEMORY_RECENT_MESSAGES=10
AGENT_MEMORY_COMPACTION_MAX_TOKENS=18000
AGENT_MEMORY_COMPACTION_RETRY_MAX_TOKENS=50000
AGENT_MEMORY_COMPACTION_ATTEMPTS=2
# 记忆整理中每个成功或失败工具结果保留的最大字符数
# Maximum retained characters per successful or failed tool result during compaction
SUCCESS_TOOL_RESULT_MAX_CHARS=800
ERROR_TOOL_RESULT_MAX_CHARS=2000
# 低于 LOW 时关闭思考，达到 LOW、HIGH、MAX 后依次使用对应强度
# Disable thinking below LOW, then use low, high, and max at each threshold
AGENT_MEMORY_THINKING_LOW_CHARS=4000
AGENT_MEMORY_THINKING_HIGH_CHARS=15000
AGENT_MEMORY_THINKING_MAX_CHARS=35000

# 工具设置
# Tool settings
AGENT_COMMAND_TIMEOUT_SECONDS=30
AGENT_TOOL_OUTPUT_MAX_CHARS=30000
AGENT_MAX_TOOL_ROUNDS=24
AGENT_MAX_TOOL_CALLS=48
AGENT_UNLIMITED_TOOL_CALLS=0
